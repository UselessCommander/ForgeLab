# ── Log ind på localhost (uden deploy / push) ─────────────────────────────
# ForgeLab bruger IKKE en separat "lokal database" til login — Next.js på din
# maskine taler med den Supabase-instans du peger på i .env.local.
#
# Sådan får du samme bruger som i produktion/staging på http://localhost:3000:
#   1) Opret .env.local i projektroden (git ignorerer den — den committes ikke).
#   2) Sæt præcis de samme to variabler som på Vercel (eller fra Supabase Dashboard
#      → Project Settings → API): NEXT_PUBLIC_SUPABASE_URL og NEXT_PUBLIC_SUPABASE_ANON_KEY
#   3) Genstart dev-server: npm run dev
# Derefter slår login op mod tabellen "users" i DEN database — din eksisterende
# konto virker lokalt uden at du skal pushe kode.
#
# Hvis de to NEXT_PUBLIC_SUPABASE_* mangler: appen kører i mock/no-op mode — så
# findes ingen rigtige brugere i "databasen", og almindelig login fejler. Du kan
# stadig bruge ADMIN_USERNAME + ADMIN_PASSWORD ovenfor (sæt evt. i .env.local).

# Base URL (optional)
BASE_URL=https://forgelab.dk

# Resend email
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=ForgeLab <no-reply@forgelab.dk>

# Stripe billing (abonnement)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRO_PRICE_ID=price_your_pro_plan_price_id_here
# Valgfri fallback:
# STRIPE_PRICE_ID=price_your_pro_plan_price_id_here
# NEXT_PUBLIC_STRIPE_PRICE_ID=price_your_pro_plan_price_id_here

# AI provider switch for chat route: auto | max | google | openai | anthropic | openrouter | mistral | groq | kimi
# OpenRouter: sæt AI_PROVIDER=openrouter + OPENROUTER_API_KEY (+ valgfri OPENROUTER_MODEL)
AI_PROVIDER=google

# Google AI (Gemini API — @ai-sdk/google)
# Du kan bruge én af disse aliases:
# GOOGLE_GENERATIVE_AI_API_KEY (anbefalet), GOOGLE_API_KEY eller GEMINI_API_KEY
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# OpenAI / ChatGPT API
OPENAI_API_KEY=

# Anthropic / Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenRouter API (Chat Completions — model-id som i OpenRouter UI)
# ForgeLab UI/API: nvidia/nemotron-3-super-120b-a12b:free, minimax/minimax-m2.5:free,
# openai/gpt-oss-120b:free, nvidia/nemotron-3-nano-30b-a3b:free, google/gemma-4-31b-it:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free


MOONSHOT_API_KEY=sk-your_moonshot_api_key_here
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.5

# Mistral API
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Groq API (OpenAI-kompatibel — hurtige Llama/Mixtral-modeller)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Projekt-docs (Yjs + Realtime): sæt til 1 for [docs-sync] sporingslog i browserkonsollen
# NEXT_PUBLIC_DOCS_SYNC_DEBUG=1
