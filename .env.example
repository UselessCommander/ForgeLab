# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here
# Valgfri: service role til profilbilleder i Storage (anbefalet i prod; ellers små filer gemmes som data-URL)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Admin Account (optional)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Base URL (optional)
BASE_URL=https://forgelab.dk

# Resend email
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=ForgeLab <no-reply@forgelab.dk>

# AI provider switch for chat route: auto | max | google | openai | anthropic | openrouter | mistral | groq | kimi
# Gemma 4 31B gratis: sæt AI_PROVIDER=openrouter + OPENROUTER_MODEL=google/gemma-4-31b-it:free + OPENROUTER_API_KEY
AI_PROVIDER=google

# Google AI (Gemini API — @ai-sdk/google)
# Du kan bruge én af disse aliases:
# GOOGLE_GENERATIVE_AI_API_KEY (anbefalet), GOOGLE_API_KEY eller GEMINI_API_KEY
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# OpenAI / ChatGPT API
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic / Claude API
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenRouter API (OpenAI-compatible — her bruger du OpenRouter model-id, fx Gemma 4 31B gratis)
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Kimi / Moonshot (officiel API — Slides-fanen). OpenAI-kompatibel: https://api.moonshot.ai/v1
# Brug MOONSHOT_API_KEY eller KIMI_API_KEY (begge understøttes; én er nok).
# Valgfrit: MOONSHOT_BASE_URL hvis du skal bruge anden region (fx https://api.moonshot.cn/v1).
MOONSHOT_API_KEY=sk-your_moonshot_api_key_here
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.5

# Mistral API
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Groq API (OpenAI-kompatibel — hurtige Llama/Mixtral-modeller)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Projekt-docs (Yjs + Realtime): sæt til 1 for [docs-sync] sporingslog i browserkonsollen
# NEXT_PUBLIC_DOCS_SYNC_DEBUG=1
