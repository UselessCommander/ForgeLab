# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here

# Admin Account (optional)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Base URL (optional)
BASE_URL= https://forgelab.dk

# Resend email
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=ForgeLab <no-reply@forgelab.dk>

# AI provider switch for chat route: auto | max | google | openai | anthropic | openrouter | mistral | groq | kimi
# Gemma 4 31B gratis: sæt AI_PROVIDER=openrouter + OPENROUTER_MODEL=google/gemma-4-31b-it:free + OPENROUTER_API_KEY
AI_PROVIDER=google

# Google AI (Gemini API — @ai-sdk/google; IKKE OpenRouter model-id’er som google/gemma-…)
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...
GOOGLE_MODEL=gemini-2.5-flash

# OpenAI / ChatGPT API
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic / Claude API
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenRouter API (OpenAI-compatible — her bruger du OpenRouter model-id, fx Gemma 4 31B gratis)
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Kimi / Moonshot (officiel API — Slides-fanen). OpenAI-kompatibel: https://api.moonshot.ai/v1
# Brug MOONSHOT_API_KEY eller KIMI_API_KEY (begge understøttes; én er nok).
# Valgfrit: MOONSHOT_BASE_URL hvis du skal bruge anden region (fx https://api.moonshot.cn/v1).
MOONSHOT_API_KEY=sk-lrOOoXcbWMpbr3ItyFnC3HAV35TwYOcL88nJgtKLDaOgFrHt
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.5

# Mistral API
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Groq API (OpenAI-kompatibel — hurtige Llama/Mixtral-modeller)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
